{
  "name": "collab-docs-demo",
  "version": "1.0.0",
  "private": true,
  "description": "Lightweight collaborative document editor",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node --watch server/index.js",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client ci --include=dev && npm --prefix client run build",
    "start": "node --no-warnings=ExperimentalWarning server/index.js",
    "test": "node --test --no-warnings=ExperimentalWarning \"server/test/*.test.js\"",
    "test:e2e": "node e2e/smoke.cjs http://localhost:3001"
  },
  "dependencies": {
    "express": "^5.1.0",
    "mammoth": "^1.13.0",
    "marked": "^18.2.1",
    "multer": "^2.0.0",
    "sanitize-html": "^2.18.2"
  },
  "devDependencies": {
    "playwright-core": "^1.65.1",
    "supertest": "^7.1.0"
  }
}
